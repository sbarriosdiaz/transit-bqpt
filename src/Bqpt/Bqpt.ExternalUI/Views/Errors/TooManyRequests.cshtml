@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Too Many Requests</title>
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <meta http-equiv="cache-control" content="max-age=0" />
    <meta http-equiv="cache-control" content="no-cache" />
    <meta http-equiv="expires" content="0" />
    <meta http-equiv="expires" content="Tue, 01 Jan 1980 1:00:00 GMT" />
    <meta http-equiv="pragma" content="no-cache" />
    @Styles.Render("~/bundles/styles", "~/bundles/fa")
</head>
<body>

    <div class="middle-box text-center animated fadeInDown">
        <div class="error-desc">
            <div class="highlight">
                <h1 class="text-center text-danger">
                    STOP
                </h1>
                <h2>Too Many Requests!</h2>
                <h4>
                    You have requested this resource too many times in the last 60 seconds. Please click back on your browser after waiting 60 seconds to continue.
                </h4>

                <a id="js-href-login" class="btn btn-primary m-t" href="@Url.Action("Login","Account")">
                    <span class="fas fa-sign-in-alt mr-1" aria-hidden="true"></span>Login Page
                </a>
            </div>
        </div>
    </div>

    <p>&nbsp;</p>
    @Scripts.Render("~/bundles/jquery")
    <script>
        var changeHashOnLoad = function () {
            window.location.href += "#";
            setTimeout("changeHashAgain()", "50");
        }

        var changeHashAgain = function () {
            window.location.href += "1";
        }

        var storedHash = window.location.hash;

        window.setInterval(function () {
            if (window.location.hash != storedHash) {
                window.location.hash = storedHash;
            }
        }, 50);

        $(document).ready(function () {
            changeHashOnLoad();
        });
    </script>
</body>
</html>
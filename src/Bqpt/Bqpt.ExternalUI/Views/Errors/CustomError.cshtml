@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Server Error</title>
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <meta http-equiv="cache-control" content="max-age=0" />
    <meta http-equiv="cache-control" content="no-cache" />
    <meta http-equiv="expires" content="0" />
    <meta http-equiv="expires" content="Tue, 01 Jan 1980 1:00:00 GMT" />
    <meta http-equiv="pragma" content="no-cache" />
    @Styles.Render("~/bundles/styles", "~/bundles/fa")
</head>
<body>

    <div class="middle-box text-center animated fadeInDown">
        <div class="error-desc">
            <div class="highlight">
                <h1 class="text-center">
                    500
                </h1>
                <h3>
                    The server encountered something unexpected that didn't allow it to complete the request. <br /> <br />
                    You can go back to main page:
                </h3>

                <a id="hrefDash" class="btn btn-primary m-t" href="@Url.Action("Index","Bids")">
                    <span class="fas fa-tachometer-alt mr-1" aria-hidden="true"></span>Dashboard
                </a>
            </div>
        </div>
    </div>

    <p>&nbsp;</p>
</body>
</html>
<!DOCTYPE html>

<html lang="en" dir="ltr">
<head>
    <title>@ViewBag.Title | @ViewBag.ApplicationName</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="cache-control" content="max-age=0" />
    <meta http-equiv="cache-control" content="no-cache" />
    <meta http-equiv="expires" content="0" />
    <meta http-equiv="expires" content="Tue, 01 Jan 1980 1:00:00 GMT" />
    <meta http-equiv="pragma" content="no-cache" />
    <link rel="icon" href="~/favicon.ico" type="image/x-icon" />
    <meta name="description" content="@ViewBag.ApplicationDesc" />

   
    @Styles.Render("~/Content/template-support/css/site.min.css", "~/bundles/fa")

    @if (IsSectionDefined("Styles"))
    {@RenderSection("Styles", required: false)}
</head>
<body>

    <div id="wrapper" class="@Html.PageClass()">

        <!-- Navigation -->
        @Html.Partial("_Navigation")

        <!-- Page wraper -->
        <div id="page-wrapper" class="gray-bg @ViewBag.SpecialClass">

            <!-- Top Navbar -->
            @Html.Partial("_TopNavbar")
            <div class="row wrapper border-bottom white-bg page-heading hidden-print">
                <div class="col-lg-10" itemscope itemtype="http://schema.org/Manager">
                    <h2 aria-label="page-header">
                        @ViewBag.PageTitle
                    </h2>
                    @ViewBag.ApplicationDesc
                    <div>
                    <div>
                        ----------------------------
                    </div>
                        <button  class="btn btn-danger btn-sm float-left mr-1" type="button" onclick="bidApp.OpenSyncVendorInfo()">
                            Sync Vendor Info
                        </button>
                    </div>
                </div>
            </div>

            <!-- Main view  -->
            <div class="wrapper wrapper-content">
                @RenderBody()
            </div>

            <!-- Footer -->
            @Html.Partial("_Footer")
        </div>
        <!-- End page wrapper-->
    </div>
    <!-- End wrapper-->
    <!-- Modal -->
    <div class="modal fade" id="js-dynamic-modal" data-backdrop="static" data-keyboard="false" tabindex="-1" aria-labelledby="js-dynamic-modal-label" aria-hidden="true">
        <div id="js-dynamic-modal-dialog" class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h3 class="modal-title" id="js-dynamic-modal-label"></h3>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body" id="js-dynamic-modal-content">
                    <h2>
                        <i aria-hidden="true" class="fas fa-sync fa-3x fa-spin mr-1"></i>Loading Content...
                    </h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Section for main scripts render -->
    @Scripts.Render("~/bundles/jquery", "~/bundles/jqueryval", "~/bundles/jsbootstrap", "~/bundles/jstemplate", "~/bundles/jsengine")

    <script>
        var appUrl = '@Url.Content("~")';
        if (window.navigator.msPointerEnabled) {
            window.location = "@Url.Action("BrowserNotSupported", "Error")";
        }
        $(function () {
            console.log("%cWeb Portal - Broward County FL", "color: #ff0000; font-size:35px;");
            console.log("%cAny Unauthorized Use of this Application is Illegal!", "color: #ff0000; font-size:25px;");
            $.ajaxSetup({ cache: false });
            $('.js-pnl-global-error').delay(5000).fadeOut(400);
        });
        helperApp.GlobalCleaner();
        $(document).userTimeout({
            logouturl: '@Url.Action("LogOff", "Account")',
            force: 3000,
            session: 300000
        });
    </script>
    <!-- Handler for local scripts -->
    @Html.ToastrNotifications()
    @RenderSection("scripts", required: false)
</body>
</html>
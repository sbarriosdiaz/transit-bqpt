@model IEnumerable<VendorDto>

@{
    var vrow = 0;
    var prow = ViewBag.Id;
}
<table class="table" aria-label="Vendors">
    <thead>
        <tr>
            <th scope="col" class="w-auto mr-2" title="Vendor Contacts" colspan="2">
                Contacts
            </th>
            <th scope="col" class="w-auto" title="Asset Works Vendor Number">
                Number
            </th>
            <th scope="col" class="w-auto" title="Asset Works Vendor Name">
                Name
            </th>
            <th scope="col" class="w-auto d-none d-sm-none d-md-none d-lg-none d-xl-table-cell d-print-table-cell" title="Asset Works Vendor Contact Name">
                Contact
            </th>
            <th scope="col" class="w-auto d-none d-sm-none d-md-none d-lg-none d-xl-table-cell d-print-table-cell" title="Asset Works Vendor Phone">
                Phone
            </th>
            <th scope="col" class="w-auto d-none d-sm-none d-md-none d-lg-table-cell d-xl-table-cell d-print-table-cell" title="Asset Works Vendor Email">
                Email
            </th>
        </tr>
    </thead>
    <tbody class="align-text-bottom">
        @foreach (var v in Model.ToList())
        {
            vrow++;
            var headingId2 = "Contact_Heading_" + (prow) + (vrow).ToString();
            var collapseId2 = "Contact_Collapse_" + (prow) + (vrow).ToString();

        <tr id="@(headingId2)" class="@(string.IsNullOrEmpty(v.AssetWorksVendorEmail) ? "bg-gray-200": "")">
            <td scope="row" class="text-left align-middle pl-4" colspan="2">
                <button class="btn-secondary btn btn-xs btn-width-30" type="button" data-toggle="collapse" data-target="#@(collapseId2)" aria-expanded="true" aria-controls="@(collapseId2)">
                    @(v.ContactCount)
                </button>
            </td>
            <td class="@(string.IsNullOrEmpty(v.AssetWorksVendorEmail) ? "text-info font-weight-bold": "") text-nowrap" title="VendorId @(v.Id)">@(v.AssetWorksVendorNumber)</td>
            <td style="max-width:200px">@(v.AssetWorksVendorName)</td>
            <td class="d-none d-sm-none d-md-none d-lg-none d-xl-table-cell d-print-table-cell">@(v.AssetWorksVendorContactName)</td>
            <td class="d-none d-sm-none d-md-none d-lg-none d-xl-table-cell d-print-table-cell">@(v.AssetWorksVendorPhone)</td>
            <td class="d-none d-sm-none d-md-none d-lg-table-cell d-xl-table-cell d-print-table-cell">@(v.AssetWorksVendorEmail)</td>
        </tr>
        <tr>
            <td scope="row" colspan="14" class="p-0">
                <div id="@(collapseId2)" class="collapse" aria-labelledby="@(headingId2)" data-parent="#@(headingId2)">
                    @Html.Partial("_ContactsPartial", v.Contacts)
                </div>
            </td>
        </tr>
        }
    </tbody>
</table>
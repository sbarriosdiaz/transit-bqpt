<div class="row border-bottom pb-2">
    <div class="col-2">
        <nav class="navbar navbar-static-top" role="navigation" style="margin-bottom: 0">
            <div class="navbar-header">
                <a class="navbar-minimalize minimalize-styl-2 btn btn-primary " href="#" aria-label="hambuerger"><span class="fas fa-align-justify" aria-hidden="true"></span></a>
            </div>
        </nav>
    </div>
    <div class="col-10 hidden-print">
        @using (Html.BeginForm("LogOff", "Account", FormMethod.Get, new { id = "signOutForm" }))
        {
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger float-right login-button" data-toggle="tooltip" data-placement="bottom" title="Log Out From Portal" aria-label="SignOut">
            <span class="fas fa-sign-out-alt fa-fw"></span>
        </button>
        <button type="button" class="btn btn-default border-dark  float-right login-button btn-labeled" data-container="body" data-toggle="popover" data-placement="bottom" data-trigger="focus" data-html="true" title="User Identity Card" data-content="@Html.Raw(HttpUtility.HtmlDecode(ViewBag.Card))" aria-label="SignOut">
            <span class="btn-label">
                <span class="fas fa-user-tag fa-fw"></span>
            </span>
            @ViewBag.UserCommonName
        </button>
       
        <div class="dropdown-menu">
            @Html.Raw(HttpUtility.HtmlDecode(ViewBag.MyApps))
        </div>
        }
    </div>
</div>
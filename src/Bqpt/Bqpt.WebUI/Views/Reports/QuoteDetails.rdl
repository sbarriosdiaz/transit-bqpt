<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="TransitBQP">
      <DataSourceReference>/Transit-BQPT/BQPT_Connection</DataSourceReference>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>6bf2e417-5e2f-4ed5-a038-d0751be59c68</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>TransitBQP</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@BidQuoteId">
            <Value>=Parameters!BidQuoteId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @cols AS NVARCHAR(MAX),  @query AS NVARCHAR(MAX), @comma1 As  NVARCHAR(MAX),@comma2 As  NVARCHAR(MAX)
--DECLARE @BidQuoteId AS NVARCHAR(MAX) =  'BT0001-2022-0000047';
DECLARE @BID AS NVARCHAR(MAX) ;
Set @cols = (SELECT STRING_AGG(QUOTENAME([AssetWorksVendorName]),',') 
                FROM (SELECT DISTINCT [AssetWorksVendorName] 
                        FROM [TransitBQP].[dbo].[Vendor])VN );
Set @comma1 = ' + '' , $'' + ';
Set @comma2 = ' + '' , '' + ';

--SET @BID = 'BT0001-2022-0000047'
SET @BID = '''' +  @BidQuoteId +'''';
--Print @BidQuoteId;
SET @query = N'Select * into #Temp from 
(SELECT * FROM   
	(SELECT   (Cast(a.IsSelected as Varchar(1)) ' + @comma1 +'Cast(a.UnitPrice as Varchar(12))'+ @comma2 + 'Cast(a.[EstimateDeliveryDate] as Varchar(12))) VendorBid
			,b.AssetWorksPartNumber
			,c.AssetWorksVendorName AssetWorksVendorName
                        ,b.AssetWorksPartQuantityOnHand
                        ,b.RequestedQuantity
		FROM [TransitBQP].[dbo].[VendorPartBid] a, [TransitBQP].[dbo].[BidQuotePart] b, [TransitBQP].[dbo].[Vendor] c
		where 
		   a.VendorId = c.Id and
		   a.BidQuotePartId= b.Id and 
		   BidQuotePartId in (SELECT ID
							  FROM [TransitBQP].[dbo].[BidQuotePart] where BidQuoteId =(SELECT  Id
																   FROM [TransitBQP].[dbo].[BidQuote]
																   where AssetWorksBidQuoteId =  ' + @BID + ' ) )
								) as p_bqp
	PIVOT(
		 max(VendorBid)
		FOR [AssetWorksVendorName] IN (' + @cols + N')
		) as pivot_table ) x

select  distinct BidQuote.AssetWorksBidQuoteId,BidQuotePart.AssetWorksPartDescription
		,BidQuotePart.AssetWorksPartCategory,BidQuotePart.AssetWorksUnitPrice, BidQuotePart.AssetWorksPartCommodityCode,BidQuotePart.AssetWorksPartManufacturerPartNumber, BidQuotePart.AssetWorksPartSuffix
       ,#Temp.* 
from #Temp
left join [TransitBQP].[dbo].BidQuote      on [TransitBQP].[dbo].BidQuote.AssetWorksBidQuoteId     = '+ @BID + '
left join [TransitBQP].[dbo].BidQuotePart  on [TransitBQP].[dbo].BidQuotePart.BidQuoteId = BidQuote.Id and BidQuotePart.AssetWorksPartNumber = #Temp.AssetWorksPartNumber'


EXEC sp_executesql @query;</CommandText>
        <Timeout>600</Timeout>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>

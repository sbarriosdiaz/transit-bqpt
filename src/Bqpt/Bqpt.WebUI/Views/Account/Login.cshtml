@model ApplicationLoginViewModel

@{
    /**/

    Layout = null;
}
<!DOCTYPE html>
<html lang="en-US">
<head>
    <title>Login to Application</title>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="cache-control" content="max-age=0" />
    <meta http-equiv="cache-control" content="no-cache" />
    <meta http-equiv="expires" content="0" />
    <meta http-equiv="expires" content="Tue, 01 Jan 1980 1:00:00 GMT" />
    <meta http-equiv="pragma" content="no-cache" />
    <noscript>
        <meta http-equiv="refresh" content="0; URL=@Url.Action("NoJavascript","Error")" />
    </noscript>
    <link rel="icon" href="~/favicon.ico" type="image/x-icon" />
    @Styles.Render("~/Content/template-support/css/site.min.css", "~/bundles/fa")
</head>
<body class="login-bg">
    <div class="loginColumns">
        <div class="login-wrap">
            <div class="row">
                <div class="col-md-7 d-none d-sm-block">
                    <img src="~/Content/template-support/images/BC-Logo.jpg" class="bc-logo" alt="Welcome" />
                    <h2>
                        @ViewBag.ApplicationName
                    </h2>
                    <p>
                        @ViewBag.ApplicationDesc
                    </p>
                </div>
                <div class="col-md-5 col-xs-12">
                    @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "form-horizontal m-t", id = "js-form-login", autocomplete = "off" }))
                    {
                    @Html.AntiForgeryToken()
                    <h3 class="">Sign in to start your session</h3>
                    @Html.Partial("_ValidationSummary", ViewData.ModelState)
                    <div class="form-row">
                        <div class="input-group">
                            <span class="input-group-addon">
                                <span class="fa fa-user" aria-hidden="true"></span>
                            </span>
                            @Html.TextBoxFor(m => m.Username, new
                            {
                                @class = "form-control",
                                placeholder = "Username...",
                                autocomplete = "new-username",
            required = "required"
                            })
                        </div>
                        @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-validation float-left" })
                    </div>
                    <div class="form-row mt-3">
                        <div class="input-group">
                            <span class="input-group-addon">
                                <span class="fa fa-lock" aria-hidden="true"></span>
                            </span>
                            @Html.PasswordFor(m => m.Password, new
                            {
                                @class = "form-control",
                                placeholder = "Password",
                                autocomplete = "new-password",
                                required = "required"
                            })
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-validation float-left" })
                    </div>
                    <div class="form-group mt-4">
                        <button id="btnLogin" class="btn btn-primary " type="submit">
                            <strong>
                                <span class="fas fa-sign-in-alt  mr-1" aria-hidden="true"></span>Log in
                            </strong>
                        </button>
                        <p class="float-right mt-2">
                            <strong>
                                Build: @ViewBag.ApplicationVer
                            </strong>
                        </p>
                        @Html.HiddenFor(m => m.ReturnUrl)
                    </div>
                    }
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="col-md-10">
                    <small>
                        Powered by <a href="http://broward.org/" rel="noopener noreferrer" target="_blank">Broward County</a> Enterprise Technology Services - Application Services Group
                    </small>
                </div>
                <div class="col-md-2 text-right d-none d-sm-block">
                    <small>© @DateTime.Now.Year</small>
                </div>
            </div>
        </div>
    </div>
    @Scripts.Render("~/bundles/jquery", "~/bundles/jqueryval", "~/bundles/jsbootstrap", "~/bundles/jstemplate", "~/bundles/jsengine")

    <script type="text/javascript">
                 if (window.navigator.msPointerEnabled) {
                    window.location = '@Url.Action("BrowserNotSupported", "Error")';
                }

                var changeHashOnLoad = function () {
                    window.location.href += "#";
                    setTimeout("changeHashAgain()", 50);
                };
                var changeHashAgain = function () {
                    window.location.href += "1";
        };
        $(function () {

            changeHashOnLoad();
            loginApp.Init();

            setTimeout(function () {
                window.location.href = '@Url.Action("Login","Account")';
            }, 300000);

         console.log("%cWeb Portal - Broward County FL", "color: #ff0000; font-size:35px;");
            console.log("%cAny Illegal Use is unauthorized!", "color: #ff0000; font-size:25px;");
                });
    </script>
</body>
</html>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Server Error</title>
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <meta http-equiv="cache-control" content="max-age=0" />
    <meta http-equiv="cache-control" content="no-cache" />
    <meta http-equiv="expires" content="0" />
    <meta http-equiv="expires" content="Tue, 01 Jan 1980 1:00:00 GMT" />
    <meta http-equiv="pragma" content="no-cache" />
    @Styles.Render("~/bundles/styles", "~/bundles/fa")
</head>
<body>

    <div class="middle-box text-center animated fadeInDown">
        <div class="error-desc">
            <div class="highlight">
                <h1 class="text-center">
                    <i class="fas fa-cookie-bite" aria-hidden="true"></i>
                </h1>
                <h3>
                    This Application Require cookies, please allow cookies in your browser and click the button below.
                </h3>
                <form>@Html.AntiForgeryToken()</form>
                <a id="js-href-dash" class="btn btn-primary m-t" href="@Url.Action("Login","Account")">
                    <span class="fas fa-user mr-1" aria-hidden="true"></span>Go Back to Login Screen
                </a>
            </div>
        </div>
    </div>

    <p>&nbsp;</p>
</body>
</html>
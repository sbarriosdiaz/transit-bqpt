@{

    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>Your Browser is not supported</title>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <!-- Tell the browser to be responsive to screen width -->
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <meta http-equiv="cache-control" content="max-age=0" />
    <meta http-equiv="cache-control" content="no-cache" />
    <meta http-equiv="expires" content="0" />
    <meta http-equiv="expires" content="Tue, 01 Jan 1980 1:00:00 GMT" />
    <meta http-equiv="pragma" content="no-cache" />

    @Styles.Render("~/bundles/styles", "~/bundles/fa")
</head>
<body>
    <div class="container">
        <div class="row">
            <br /><br />
            <div class="col-md-12 mt-5">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h4>
                            Supported Browsers
                        </h4>
                    </div>
                    <div class="panel-body">
                        <h2>
                            Outdated Browser
                        </h2>
                        <p>
                            The browser you are using is not supported.
                        </p>
                        <p>
                            <img src="~/Content/template-support/images/browsers-bg.png" title="Supported Browesers" alt="" class="img-fluid img-shadow" />
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-12">
                <div class="text-center">
                    <button type="button" class="btn btn-primary" onclick="window.close();">
                        Close Window
                    </button>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
@model BidQuoteAllDashboardResponseDto

@{
    /**/

    ViewBag.Title = "All Bids";
    ViewBag.PageTitle = Html.Raw("<span class='fas fa-file-invoice mr-1'></span>All Bids");
}
@section styles{
    @Styles.Render("~/bundles/dtstyles")
}
@section scripts {
    @Scripts.Render("~/bundles/dtjs")
    <script>
        $(function () {
            helperApp.InitDtSimple('dt-bids');
        })
    </script>
}

<div class="row">

    <div class="col-md-12">
        <div class="ibox">
            <div class="ibox-title">
                <h3><i class="fas fa-list mr-1" aria-hidden="true"></i>All Bids</h3>
                <h5><i class="fa fa-tim mr-1" aria-hidden="true"></i> All Bids (New,Open,Closed,Ended)</h5>
                <small><i class="fa fa-tim mr-1" aria-hidden="true"></i> Total Bids : @(Model.AllBidQuotes.Count()) </small>
            </div>

            <div class="ibox-content">

                @Html.Partial("_BidQuotesAllPartial", Model.AllBidQuotes)
            </div>
        </div>
    </div>
</div>